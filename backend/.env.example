# --- Database ---
DATABASE_URL=sqlite:///./pricedrop.db

# --- Telegram drop alerts (bot from /bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Drop threshold: alert when price falls X% below the all-time minimum
DROP_THRESHOLD_PCT=5

# --- Background checker ---
CHECKER_ENABLED=true
CHECKER_INTERVAL_SECONDS=21600

# --- Security ---
# API key required on all endpoints (except /health and /docs)
API_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
# text (default) or json for structured logs
LOG_FORMAT=text
CORS_ORIGINS=*

# --- Notifier ---
# Retries and backoff for Telegram drop alerts
NOTIFY_RETRIES=3
NOTIFY_BACKOFF=0.5
# Cooldown between notifications for the same product (seconds)
NOTIFY_COOLDOWN_SECONDS=86400

# --- Dedupe ---
# Skip identical price points recorded within this window (seconds)
DEDUPE_WINDOW_SECONDS=3600

# --- Shopee Affiliate Open API (AMS) ---
# Register: affiliate.shopee.co.id -> Open Platform
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_PARTNER_ID=

# --- TikTok Shop Affiliate API (Partner Center) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
